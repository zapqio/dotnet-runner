#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$root/scripts/security/Scan-Secrets.ps1" -Mode Staged
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/security/Scan-Secrets.ps1" -Mode Staged
else
    echo 'Secret scan requires PowerShell. Install it and run scripts/security/Install-Gitleaks.ps1 -InstallHooks.' >&2
    exit 1
fi
