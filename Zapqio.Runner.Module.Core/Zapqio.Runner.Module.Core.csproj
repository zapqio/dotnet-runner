<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Settings -->
    <PackageId>Zapqio.Runner.Module.Core</PackageId>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>1.2.0: RunnerLog - log zadania z jawnie nazwaną wagą wpisu (Debug, Info, Warning, Error, Critical) zamiast wyłącznie Console.WriteLine/Console.Error. Runner udostępnia też ILogger&lt;T&gt; w kontenerze modułów. AssemblyVersion bez zmian, moduły 1.0 i 1.1 działają bez przebudowy; ich Console.WriteLine dalej idzie na Info, a Console.Error na Error.&#xD;&#xA;1.1.0: JobContext.Current - kontekst zadania (id operacji, id próby, nazwa metody) dostępny w IRunnerMethod.Run bez zmiany interfejsu.</PackageReleaseNotes>
    <!-- Tozsamosc kontraktu musi byc stabilna i zgodna z wersja paczki NuGet, przeciw ktorej
         kompiluja sie moduly. Bez tego -p:Version=<wersja release'u> z release.yml nadpisuje
         AssemblyVersion (np. na 0.1.4.0) i moduly przestaja sie wiazac: "The located assembly's
         manifest definition does not match the assembly reference" (0x80131040). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Zapqio</Authors>
    <Company>Hdwr global</Company>
    <Product>Zapqio Runner Module Lib</Product>
    <Description>Core interfaces for creating Zapqio Runner modules. Implement IRunnerMethod to create pipeline methods and IRunnerInjection for dependency injection; use RunnerLog for levelled job logging and JobContext for per-job identifiers.</Description>
    <PackageTags>zapqio;runner;pipeline;automation</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zapqio/dotnet-runner</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zapqio/dotnet-runner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>

    <!-- Generate NuGet package on build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- Include XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="NUGET.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
