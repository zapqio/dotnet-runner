{
  "MaxWebSocketMessageBytes": 33554432,
  "Logger": {
    "LogLevel": "Information",
    "PathDirectory": "Logs" // empty not save logs to file
  },
  "Token": "", // or env ZAPQIO_TOKEN (key runner with web)
  "Name": "", //generate if empty or env ZAPQIO_NAME
  "Url": "", // or env ZAPQIO_URL e.g. wss://localhost
  "MaxConcurrency": 1, // or env ZAPQIO_MAX_CONCURRENCY; jobs run at once, only for modules ready for concurrent calls
  "StopTimeoutSeconds": 30, // on stop: wait this long for running jobs and their results before closing
  "MaxQueuedLogLines": 10000, // log lines kept while the platform is unreachable; further lines are dropped
  "MinRemoteLogLevel": "Info" // or env ZAPQIO_MIN_LOG_LEVEL; lowest module log level sent to the platform: Debug, Info, Warning, Error, Critical
}
